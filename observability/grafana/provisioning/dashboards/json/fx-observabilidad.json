{
  "uid": "fx-observabilidad",
  "title": "Microservicios FutureX — Observabilidad",
  "description": "Métricas de fx-catalog-service y fx-course-service enviadas por OTLP al OpenTelemetry Collector (taller 4).",
  "tags": [
    "opentelemetry",
    "taller-4"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Resumen",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Peticiones por minuto (ambos servicios)",
      "description": "Peticiones HTTP atendidas por fx-catalog-service y fx-course-service (métrica http.server.requests de Spring Boot).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(otel_http_server_requests_seconds_count[$__rate_interval])) * 60",
          "legendFormat": "req/min",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "% de error del catálogo (5 min)",
      "description": "Peticiones del catálogo resueltas con un fallback (fx-course-service no respondió o el circuito estaba abierto) sobre el total de peticiones del catálogo.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(sum(rate(otel_catalog_fallback_total[5m])) or vector(0)) / sum(rate(otel_http_server_requests_seconds_count{exported_job=\"fx-catalog-service\"}[5m]))",
          "legendFormat": "error",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Circuito courseService",
      "description": "Estado del Circuit Breaker de Resilience4j que protege las llamadas del catálogo a fx-course-service.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max(otel_resilience4j_circuitbreaker_state{exported_job=\"fx-catalog-service\", name=\"courseService\", state=\"half_open\"}) + 2 * max(otel_resilience4j_circuitbreaker_state{exported_job=\"fx-catalog-service\", name=\"courseService\", state=~\"open|forced_open\"})",
          "legendFormat": "estado",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "CERRADO",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "SEMIABIERTO",
                  "color": "yellow",
                  "index": 1
                },
                "2": {
                  "text": "ABIERTO",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Fallbacks en el rango",
      "description": "Respuestas de respaldo del catálogo en el rango de tiempo seleccionado.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(otel_catalog_fallback_total[$__range])) or vector(0)",
          "legendFormat": "fallbacks",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Tráfico y latencia",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Peticiones por minuto por endpoint",
      "description": "Tasa de peticiones HTTP por servicio y endpoint, en peticiones por minuto.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (exported_job, uri) (rate(otel_http_server_requests_seconds_count[$__rate_interval])) * 60",
          "legendFormat": "{{exported_job}} {{uri}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Tiempo de respuesta de /catalog",
      "description": "Promedio en ventana de 15 minutos (consulta del taller), separado por el resultado de la llamada a fx-course-service, y percentil 95 calculado con el histograma.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "rate(otel_catalog_courses_request_seconds_sum{endpoint=\"/catalog\"}[15m]) / rate(otel_catalog_courses_request_seconds_count{endpoint=\"/catalog\"}[15m])",
          "legendFormat": "promedio 15 min ({{outcome}})",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(otel_catalog_courses_request_seconds_bucket{endpoint=\"/catalog\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Tiempo de respuesta promedio por endpoint del catálogo",
      "description": "Duración promedio de cada endpoint del catálogo, incluida la llamada a fx-course-service (Timers catalog.*.request).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (endpoint) (rate({__name__=~\"otel_catalog_.+_request_seconds_sum\"}[$__rate_interval])) / sum by (endpoint) (rate({__name__=~\"otel_catalog_.+_request_seconds_count\"}[$__rate_interval]))",
          "legendFormat": "{{endpoint}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Cursos consultados por minuto (fx-course-service)",
      "description": "Contador courses.accessed: consultas de la lista de cursos (/courses) y de un curso específico (/{id}).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (endpoint) (increase(otel_courses_accessed_total[1m]))",
          "legendFormat": "{{endpoint}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "row",
      "title": "Errores",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "% de error por servicio",
      "description": "En el catálogo un error es una respuesta de fallback (HTTP 200 con el mensaje de respaldo); en el servicio de cursos, una respuesta 5xx. clamp_max evita picos > 100 % por el desfase entre las dos ventanas de rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "clamp_max((sum(rate(otel_catalog_fallback_total[$__rate_interval])) or vector(0)) / sum(rate(otel_http_server_requests_seconds_count{exported_job=\"fx-catalog-service\"}[$__rate_interval])), 1)",
          "legendFormat": "fx-catalog-service (fallbacks)",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "(sum(rate(otel_http_server_requests_seconds_count{exported_job=\"fx-course-service\", outcome=\"SERVER_ERROR\"}[$__rate_interval])) or vector(0)) / sum(rate(otel_http_server_requests_seconds_count{exported_job=\"fx-course-service\"}[$__rate_interval]))",
          "legendFormat": "fx-course-service (HTTP 5xx)",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "piechart",
      "title": "Éxito vs error (últimas 6 h)",
      "description": "Peticiones de ambos servicios en las últimas 6 horas. Error = fallbacks del catálogo + respuestas 5xx del servicio de cursos.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 6,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(otel_http_server_requests_seconds_count[$__range])) - ((sum(increase(otel_catalog_fallback_total[$__range])) or vector(0)) + (sum(increase(otel_http_server_requests_seconds_count{outcome=\"SERVER_ERROR\"}[$__range])) or vector(0)))",
          "legendFormat": "Éxito",
          "range": false,
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "(sum(increase(otel_catalog_fallback_total[$__range])) or vector(0)) + (sum(increase(otel_http_server_requests_seconds_count{outcome=\"SERVER_ERROR\"}[$__range])) or vector(0))",
          "legendFormat": "Error",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Éxito"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "pieType": "donut",
        "displayLabels": [
          "percent"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "values": [
            "value",
            "percent"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "timeFrom": "6h"
    },
    {
